# ─── Supabase ───────────────────────────────────────────────────────────────
# Obtenlos en: https://supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Resend (email transaccional) ───────────────────────────────────────────
# Obtenlo en: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dominio verificado en Resend desde el que se envían los correos
RESEND_FROM_EMAIL=reservas@turestaurante.com
RESEND_FROM_NAME=El Nombre del Restaurante

# ─── URL pública de la aplicación ───────────────────────────────────────────
# En local: http://localhost:3000 · En producción: https://tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron secret (para proteger el endpoint de recordatorios) ───────────────
# Genera uno aleatorio: openssl rand -hex 32
CRON_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# ─── Autenticación del panel interno ────────────────────────────────────────
# Se gestiona a través de Supabase Auth (email + contraseña)
# Crea el usuario en: Supabase Dashboard → Authentication → Users → Add user
